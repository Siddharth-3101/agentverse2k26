# ─── Database Configuration ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agentverse
DB_USER=root
DB_PASSWORD=qwerty

# ─── Shared JWT Secret (used by ALL services) ──────────────────────────────
JWT_SECRET=agentverse_secret_key_2026

# ─── Individual Service Ports ──────────────────────────────────────────────
AUTH_PORT=5001
CLUB_PORT=5002
APPLICATION_PORT=5003
NOTIFICATION_PORT=5004
ACTIVITY_PORT=5005
ANALYTICS_PORT=5006

# ─── Inter-Service URLs (used when cross-service HTTP calls are needed) ────
AUTH_SERVICE_URL=http://localhost:5001
CLUB_SERVICE_URL=http://localhost:5002
APPLICATION_SERVICE_URL=http://localhost:5003
NOTIFICATION_SERVICE_URL=http://localhost:5004
ACTIVITY_SERVICE_URL=http://localhost:5005
ANALYTICS_SERVICE_URL=http://localhost:5006

# ─── Frontend Origin (used for CORS) ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Server / Misc ─────────────────────────────────────────────────────────
NODE_ENV=development
